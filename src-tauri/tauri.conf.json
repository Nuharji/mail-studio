{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail Studio",
  "mainBinaryName": "mail-studio",
  "version": "0.1.0",
  "identifier": "com.studiofamily.mailstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mail Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; frame-src 'self' about: data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "E-mail for all your accounts",
    "longDescription": "Read and write e-mail from iCloud, Gmail, GMX, WEB.DE, Proton (Bridge) and any IMAP/SMTP account — passwords in the system keychain, mail cached for offline reading.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}